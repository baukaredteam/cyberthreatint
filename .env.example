# Настройки Telegram бота
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# URL для подключения к Certstream
CERTSTREAM_URL=wss://certstream.calidog.io

# Путь к базе данных SQLite
DATABASE_PATH=./data/phishing.db

# Уровень логирования (debug, info, warn, error)
LOG_LEVEL=info

# Домены клиентов для мониторинга (через запятую)
CLIENT_DOMAINS=qazpost.kz,example.com,client1.com,client2.com

# Интервал обновления баз данных (в минутах)
UPDATE_INTERVAL=60

# Порог схожести доменов (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.8

# ============================================
# MISP SOC Bot Configuration
# ============================================

# MISP API Settings
MISP_BASE_URL=https://misp.your-organization.kz
MISP_API_KEY=YOUR_MISP_API_KEY_HERE
MISP_SKIP_TLS_VERIFY=true

# Telegram Chat IDs для MISP уведомлений (через запятую)
# Можно указать ID группы или канала (с минусом, например: -1001234567890)
TELEGRAM_CHAT_IDS=-1001234567890,-1009876543210

# Интервал опроса MISP API (в секундах)
POLL_INTERVAL_SECONDS=60